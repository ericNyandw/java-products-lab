# PostgreSQL Configuration
POSTGRES_DB: product2_db# 👈  ici # ✅ Correspondance au backend
POSTGRES_USER: postgres
POSTGRES_PASSWORD: admin

# Spring Boot Configuration
# 1. On utilise 'db' (nom du service) et 5432 (port interne Docker)
# 2. On utilise 'product2_db' pour correspondre à code
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/product2_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=admin
SPRING_JPA_HIBERNATE_DDL_AUTO=update# ✅ Crée les tables automatiquement
 # On rajoute ces deux-là pour être sûr que Docker suit mon .properties
SPRING_JMX_ENABLED=false# ✅ Désactive JMX (pas nécessaire en production)
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.actuate.autoconfigure.ssl.SslObservabilityAutoConfiguration,org.springframework.boot.actuate.autoconfigure.endpoint.jmx.JmxEndpointAutoConfiguration# ✅ Fix de compatibilité

