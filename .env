# PostgreSQL Configuration
POSTGRES_DB: product2_db# 👈  ici # ✅ Correspondance au backend
POSTGRES_USER: postgres
POSTGRES_PASSWORD: admin

# Spring Boot Configuration
# 1. On utilise 'db' (nom du service) et 5432 (port interne Docker)
# 2. On utilise 'product2_db' pour correspondre à code
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/product2_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=admin
# Crée les tables automatiquement
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# On rajoute ces deux-là pour être sûr que Docker suit mon .properties
#Désactive JMX car le bean MBeanServer manque dans le parent 3.4.5
SPRING_JMX_ENABLED=false
# Exclut les configurations SSL/JMX incompatibles avec l'Actuator 3.5.12
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.actuate.autoconfigure.ssl.SslObservabilityAutoConfiguration,org.springframework.boot.actuate.autoconfigure.endpoint.jmx.JmxEndpointAutoConfiguration

